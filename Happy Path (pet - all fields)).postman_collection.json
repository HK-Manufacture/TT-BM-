    {
      "name": "Update Pet (status)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const currentStatus = pm.collectionVariables.get('status');",
              "",
              "const allStatuses = ['available', 'pending', 'sold'];",
              "",
              "const availableStatuses = allStatuses.filter(s => s !== currentStatus);",
              "",
              "const newStatus = availableStatuses[Math.floor(Math.random() * availableStatuses.length)];",
              "",
              "console.log('Current status:', currentStatus);",
              "console.log('New status:', newStatus);",
              "",
              "pm.collectionVariables.set('newStatus', newStatus);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test('Pet status was changed', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedNewStatus = pm.collectionVariables.get('newStatus');",
              "    ",
              "    console.log('Expected new status:', expectedNewStatus);",
              "    console.log('Response new status:', jsonData.status);",
              "    ",
              "    pm.expect(jsonData.status).to.eql(expectedNewStatus);",
              "});",
              "",
              "pm.test('All fields except status remain unchanged', function () {",
              "    const jsonData = pm.response.json();",
              "    const originalData = JSON.parse(pm.collectionVariables.get('originalPetData'));",
              "    ",
              "    console.log('Original data:', originalData);",
              "    console.log('Updated data:', jsonData);",
              "    ",
              "    pm.expect(jsonData.id).to.eql(originalData.id);",
              "    pm.expect(jsonData.name).to.eql(originalData.name);",
              "    pm.expect(jsonData.category.id).to.eql(originalData.category.id);",
              "    pm.expect(jsonData.category.name).to.eql(originalData.category.name);",
              "    pm.expect(jsonData.photoUrls[0]).to.eql(originalData.photoUrls[0]);",
              "    pm.expect(jsonData.tags[0].id).to.eql(originalData.tags[0].id);",
              "    pm.expect(jsonData.tags[0].name).to.eql(originalData.tags[0].name);",
              "",
              "});",
              "",
              "const petSchema = JSON.parse(pm.collectionVariables.get('petSchema'));",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response matches Pet JSON schema\", () => {",
              "    pm.response.to.have.jsonSchema(petSchema);",
              "});",
              "",
              ""
            ],
