              "pm.test('Response time is less than 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Response body is an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "});",
              "",
              "pm.test('Updated pet is present in the list', function () {",
              "    const jsonData = pm.response.json();",
              "    const petId = parseInt(pm.collectionVariables.get('petId'));",
              "    const foundPet = jsonData.find(pet => pet.id === petId);",
              "    pm.expect(foundPet).to.exist;",
              "});",
              "",
              "pm.test('All pets have correct status', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedStatus = pm.collectionVariables.get('newStatus');",
              "    ",
              "    jsonData.forEach(pet => {",
              "        pm.expect(pet.status).to.eql(expectedStatus);",
              "    });",
              "});",
