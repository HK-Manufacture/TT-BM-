  "item": [
    {
      "name": "Create Pet",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const petId = Math.floor(Math.random() * 9007199254740991);",
              "const categoryId = Math.floor(Math.random() * 9007199254740991);",
              "const tagId = Math.floor(Math.random() * 9007199254740991);",
              "",
              "const petName = pm.variables.replaceIn('{{$randomFirstName}}');",
              "const categoryName = pm.variables.replaceIn('{{$randomWord}}');",
              "const tagName = pm.variables.replaceIn('{{$randomWord}}');",
              "const petImage = pm.variables.replaceIn('{{$randomImageUrl}}');",
              "",
              "const statuses = ['available', 'pending', 'sold'];",
              "const status = _.sample(statuses);",
              "",
              "pm.collectionVariables.set('petId', petId);",
              "pm.collectionVariables.set('categoryId', categoryId);",
              "pm.collectionVariables.set('tagId', tagId);",
              "pm.collectionVariables.set('petName', petName);",
              "pm.collectionVariables.set('categoryName', categoryName);",
              "pm.collectionVariables.set('tagName', tagName);",
              "pm.collectionVariables.set('petImage', petImage);",
              "pm.collectionVariables.set('status', status);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "const petSchema = JSON.parse(pm.collectionVariables.get('petSchema'));",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response matches Pet JSON schema\", () => {",
              "    pm.response.to.have.jsonSchema(petSchema);",
              "});",
              "",
              "pm.test('Pet ID matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedId = parseInt(pm.collectionVariables.get('petId'));",
              "    ",
              "    console.log('Expected ID:', expectedId);",
              "    console.log('Response ID:', jsonData.id);",
              "    ",
              "    pm.expect(jsonData.id).to.eql(expectedId);",
              "});",
              "",
              "pm.test('Pet name matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedName = pm.collectionVariables.get('petName');",
              "    ",
              "    console.log('Expected name:', expectedName);",
              "    console.log('Response name:', jsonData.name);",
              "    ",
              "    pm.expect(jsonData.name).to.eql(expectedName);",
              "});",
              "",
              "pm.test('Pet status matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedStatus = pm.collectionVariables.get('status');",
              "    ",
              "    console.log('Expected status:', expectedStatus);",
              "    console.log('Response status:', jsonData.status);",
              "    ",
              "    pm.expect(jsonData.status).to.eql(expectedStatus);",
              "});",
              "",
              "pm.test('Category ID matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedCategoryId = parseInt(pm.collectionVariables.get('categoryId'));",
              "    ",
              "    console.log('Expected category ID:', expectedCategoryId);",
              "    console.log('Response category ID:', jsonData.category.id);",
              "    ",
              "    pm.expect(jsonData.category.id).to.eql(expectedCategoryId);",
              "});",
              "",
              "pm.test('Category name matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedCategoryName = pm.collectionVariables.get('categoryName');",
              "    ",
              "    console.log('Expected category name:', expectedCategoryName);",
              "    console.log('Response category name:', jsonData.category.name);",
              "    ",
              "    pm.expect(jsonData.category.name).to.eql(expectedCategoryName);",
              "});",
              "",
              "pm.test('PhotoUrls match request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedPetImage = pm.collectionVariables.get('petImage');",
              "    ",
              "    console.log('Expected Photo Url:', expectedPetImage);",
              "    console.log('Response Photo Url:', jsonData.photoUrls[0]);",
              "    ",
              "    pm.expect(jsonData.photoUrls[0]).to.eql(expectedPetImage);",
              "});",
              "",
              "pm.test('Tag ID matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedTagId = parseInt(pm.collectionVariables.get('tagId'));",
              "    ",
              "    console.log('Expected tag ID:', expectedTagId);",
              "    console.log('Response tag ID:', jsonData.tags[0].id);",
              "    ",
              "    pm.expect(jsonData.tags[0].id).to.eql(expectedTagId);",
              "});",
              "",
              "pm.test('Tag name matches request', function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedTagName = pm.collectionVariables.get('tagName');",
              "    ",
              "    console.log('Expected tag name:', expectedTagName);",
              "    console.log('Response tag name:', jsonData.tags[0].name);",
              "    ",
              "    pm.expect(jsonData.tags[0].name).to.eql(expectedTagName);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
